# Falcon (TII) — OpenAI-compatible endpoint (Open WebUI / vLLM)
FALCON_BASE_URL=https://chat.falconllm.tii.ae/api
FALCON_API_KEY=replace-me
# Model under test ("student")
FALCON_STUDENT_MODEL=falcon-h1-7b-instruct
# Model that translates natural language -> Lean 4 ("formalizer"); can be any model on FALCON_BASE_URL
FALCON_FORMALIZER_MODEL=falcon-h1-arabic-34b-instruct
# Who translates NL -> Lean: falcon (default, "Falcon verifies Falcon") | openai | openrouter
FORMALIZER_PROVIDER=falcon
# Keys for the optional providers (only read when FORMALIZER_PROVIDER selects them)
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# Fine-grained override of the formalizer endpoint (takes precedence over the preset)
# FORMALIZER_BASE_URL=https://api.openai.com/v1
# FORMALIZER_API_KEY=sk-...
# FORMALIZER_MODEL=gpt-4.1-mini
LEAN_PROJECT_DIR=./lean
MAX_ROUNDS=3
# On-disk memory (kernel verdicts, translations, problem history). FV_MEMORY=0 disables it.
# FV_MEMORY=1
# FV_MEMORY_PATH=./runs/memory.sqlite
