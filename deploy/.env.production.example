# Public hostname served by Caddy (DNS A record must point at this server). Use
# "localhost" or an sslip.io / nip.io name (e.g. 1-2-3-4.sslip.io) when you have no domain.
DOMAIN=verify.example.com

# Falcon (TII Open WebUI, OpenAI-compatible). Stays server-side; never sent to browsers.
FALCON_BASE_URL=https://chat.falconllm.tii.ae/api
FALCON_API_KEY=replace-me
FALCON_STUDENT_MODEL=falcon-h1-7b-instruct
FALCON_FORMALIZER_MODEL=falcon-h1-arabic-34b-instruct
FORMALIZER_PROVIDER=falcon
# Optional alternative formalizers (selectable in the UI only when the key is set)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Deployment guards
FV_MAX_CONCURRENT=2          # simultaneous Lean loops (each ~2-4 GB RAM peak)
FV_RATE_PER_HOUR=30          # solves per client IP per hour
FV_MAX_PROBLEM_CHARS=1500
FV_ACCESS_TOKEN=             # set to require X-FV-Token on the API (UI prompts for it)
FV_STUDENT_MODELS=falcon-h1-7b-instruct,falcon-h1-arabic-3b-instruct,falcon-h1r-7b
MAX_ROUNDS=3
LEAN_TIMEOUT=120
